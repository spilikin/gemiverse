{
	"name": "gemiverse",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^5.0.0",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/eslint": "^9.0.0",
		"@types/jsdom": "^28.0.3",
		"@types/node": "^22.0.0",
		"@types/node-forge": "^1.3.11",
		"carbon-components-svelte": "1.0.0-next.1",
		"carbon-icons-svelte": "^13.0.0",
		"carbon-preprocess-svelte": "^0.11.11",
		"eslint": "^10.4.0",
		"eslint-config-prettier": "^10.0.0",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^17.6.0",
		"prettier": "^3.1.1",
		"prettier-plugin-svelte": "^4.0.0",
		"svelte": "^5.49.1",
		"svelte-check": "^4.0.0",
		"tslib": "^2.4.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.4",
		"vite": "^7.3.3",
		"vitest": "^4.1.7"
	},
	"type": "module",
	"dependencies": {
		"axios": "^1.7.2",
		"iovalkey": "^0.3.1",
		"jose": "^6.0.0",
		"jsdom": "^29.1.1",
		"node-xlsx": "^0.24.0",
		"pkijs": "^3.2.4"
	}
